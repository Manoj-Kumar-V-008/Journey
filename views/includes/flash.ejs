<!-- Flash message in case of Success -->
<% if (success && success.length) { %>
    <div class="journey-toast toast-success alert alert-dismissible fade show" role="alert" id="flashToast">
        <i class="fa-solid fa-circle-check toast-icon"></i>
        <span><%= success %></span>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
<% } %>

<!-- Flash message in case of error -->
<% if (error && error.length) { %>
    <div class="journey-toast toast-error alert alert-dismissible fade show" role="alert" id="flashToast">
        <i class="fa-solid fa-circle-exclamation toast-icon"></i>
        <span><%= error %></span>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
<% } %>
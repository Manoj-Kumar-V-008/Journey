<% layout("/layouts/boilerplate") %>
<body>
    <div class="container mt-4 mb-5">
        <div class="row">
            <div class="col-md-8 offset-md-2">
                <h3 class="mb-4"><%=listings.title%></h3>

                <div class="card shadow-sm">
                    <img src="<%=listings.image.url%>" class="card-img-top" alt="<%=listings.title%>" style="height: 400px; object-fit: cover;">
                    <div class="card-body">
                        <p class="card-text text-muted"><%=listings.description%></p>

                        <ul class="list-group list-group-flush mb-3">
                            <li class="list-group-item">
                                <strong>Price:</strong> &#8377;<%= listings.price ? listings.price.toLocaleString("en-IN") : "Not available" %>
                            </li>
                            <li class="list-group-item">
                                <strong>Location:</strong> <%=listings.location%>
                            </li>
                            <li class="list-group-item">
                                <strong>Country:</strong> <%=listings.country%>
                            </li>
                        </ul>

                        <div class="d-flex gap-2">
                            <a href="/listings/<%=listings._id%>/edit" class="btn btn-outline-warning upd-btn">Edit the Listing</a>

                            <form method="POST" action="/listings/<%=listings._id%>?_method=DELETE" class="d-inline">
                                <button type="submit" class="btn btn-danger">Delete this Listing</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <div class="col-md-8 offset-md-2 mt-4">
    <div class="card shadow-sm review-card">
        <div class="card-body p-4">
            <h4 class="mb-4 review-title">Leave a Review</h4>

            <form action="/listings/<%=listings._id%>/reviews" method="POST" novalidate class="needs-validation">
                <div class="mb-4">
                    <label for="rating" class="form-label d-flex justify-content-between align-items-center">
                        <span><b>Rating</b></span>
                        <span id="ratingValue" class="badge rating-badge">
                            <i class="fa-solid fa-star"></i> 3
                        </span>
                    </label>
                    
                    <input
                        type="range"
                        class="form-range"
                        min="1"
                        max="5"
                        id="rating"
                        name="review[rating]"
                        value="3"
                        oninput="document.getElementById('ratingValue').innerHTML = '<i class=\'fa-solid fa-star\'></i> ' + this.value"
                    >
                </div>

                <div class="mb-4">
                    <label for="comment" class="form-label ">Comments</label>
                    <textarea
                        class="form-control custom-textarea"
                        name="review[comment]"
                        id="comment"
                        rows="4"
                        placeholder="Share your experience..."
                        required
                    ></textarea>

                    <div class="invalid-feedback">Please submit some comment about your experience</div>
                </div>

                <button type="submit" class="btn sub-btn">Submit</button>
            </form>
        </div>
    </div>
</div>

            <hr>

            <div class="col-md-8 offset-md-2 mt-5">
    <h4 class="review-title mb-4">
        All Reviews <span class="text-muted fw-normal">(<%= listings.reviews.length %>)</span>
    </h4>

    <% if (listings.reviews.length === 0) { %>
        <p class="card-text">No reviews yet — be the first to share your experience!</p>
    <% } else { %>
        <div class="row">
            <% for (let review of listings.reviews) { %>
                <div class="col-md-6 mb-4">
                    <div class="card review-display-card h-100">
                        <div class="card-body">
                            <h5 class="card-title">User</h5>
                            <span class="badge rating-badge mb-2">
                                <i class="fa-solid fa-star"></i> <%= review.rating %>
                            </span>
                            <p class="card-text mb-2"><%= review.comment %></p>

                            <form action="/listings/<%= listings._id %>/reviews/<%= review._id %>?_method=DELETE" method="POST">
                                <button type="submit" class="btn btn-sm delete-review-btn">Delete</button>
                            </form>
                        </div>
                    </div>
                </div>
            <% } %>
        </div>
    <% } %>
</div>
</body>
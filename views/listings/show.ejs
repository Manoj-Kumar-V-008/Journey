<% layout("/layouts/boilerplate") %>
<body>
    <div class="container mt-4 mb-5">
        <div class="row">
            <div class="col-md-8 offset-md-2">
                <h3 class="mb-4">Listing Details</h3>

                <div class="card shadow-sm">
                    <img src="<%=listings.image.url%>" class="card-img-top" alt="<%=listings.title%>" style="height: 400px; object-fit: cover;">
                    <div class="card-body">
                        <h4 class="card-title"><%=listings.title%></h4>
                        <p class="card-text text-muted"><%=listings.description%></p>

                        <ul class="list-group list-group-flush mb-3">
                            <li class="list-group-item">
                                <strong>Price:</strong> &#8377;<%= listings.price ? listings.price.toLocaleString("en-IN") : "Not available" %>
                            </li>
                            <li class="list-group-item">
                                <strong>Location:</strong> <%=listings.location%>
                            </li>
                            <li class="list-group-item">
                                <strong>Country:</strong> <%=listings.country%>
                            </li>
                        </ul>

                        <div class="d-flex gap-2">
                            <a href="/listings/<%=listings._id%>/edit" class="btn btn-outline-warning upd-btn">Edit the Listing</a>

                            <form method="POST" action="/listings/<%=listings._id%>?_method=DELETE" class="d-inline">
                                <button type="submit" class="btn btn-danger">Delete this Listing</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
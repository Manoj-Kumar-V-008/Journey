<% layout("/layouts/boilerplate")%>
<body>
    <h3>Listing Details</h3> 
    <ul>
        <li> <b>Title : <%=listings.title%></b> </li>
        <li>Description : <%=listings.description%></li>
        <li>Price : &#8377;<%=listings.price.toLocaleString("en-IN")%></li>
        <li>Location : <%=listings.location%></li>
        <li>Country : <%=listings.country%></li>
    </ul>
    <br>
    <a href="/listings/<%=listings._id%>/edit"><button>Edit the Listing</button></a>

    <form method="POST" action="/listings/<%=listings._id%>?_method=DELETE">
        <button>Delete this Listing</button>
    </form>
</body>